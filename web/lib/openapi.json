      "TestResultIn": {
        "additionalProperties": false,
        "description": "FR-34: a test result, and nothing that could be read back as a count.\n\n`area_code` and `syndrome` say which question the p-value answers; without them\ntwo results for one episode would be indistinguishable. Both are aggregate\nlabels the environmental side already publishes (the area is the zone's\npopulation Group), so neither says anything about a person.",
        "properties": {
          "area_code": {
            "title": "Area Code",
            "type": "string"
          },
          "computed_at": {
            "format": "date-time",
            "title": "Computed At",
            "type": "string"
          },
          "effect_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effect Size"
          },
          "episode_id": {
            "title": "Episode Id",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "n_days": {
            "minimum": 1.0,
            "title": "N Days",
            "type": "integer"
          },
          "p_value": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Value",
            "type": "number"
          },
          "syndrome": {
            "title": "Syndrome",
            "type": "string"
          }
        },
        "required": [
          "episode_id",
          "area_code",
          "syndrome",
          "method",
          "p_value",
          "effect_size",
          "n_days",
          "computed_at"
        ],
        "title": "TestResultIn",
        "type": "object"
      },
      "UpstreamSearchIn": {
        "additionalProperties": false,
        "description": "FR-35: an unexplained cluster, reduced to where, when and how surprising.",
        "properties": {
          "area_code": {
            "title": "Area Code",
            "type": "string"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "p_value": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Value",
            "type": "number"
          },
          "syndrome": {
            "title": "Syndrome",
            "type": "string"
          }
