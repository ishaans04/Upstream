            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "sensor_id",
          "node_id",
          "ts",
          "parameter",
          "value",
          "unit"
