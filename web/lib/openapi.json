              "type": "string"
            },
            "title": "Oah Codes",
            "type": "array"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "observer_id": {
            "title": "Observer Id",
            "type": "string"
          },
          "observer_type": {
            "title": "Observer Type",
            "type": "string"
          },
