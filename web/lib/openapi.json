                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Hook",
        "tags": [
          "cds-hooks"
        ]
      }
    },
    "/clinical/episodes": {
      "get": {
        "description": "Episodes a clinical test could still say something about.\n\nThe same rule the CDS card uses: PROBABLE or CONFIRMED, and still inside the\nclinical relevance window. A SUSPECTED episode is one unconfirmed report, and\ntesting hospital data against it would spend the health zone's attention on noise.",
        "operationId": "clinical_episodes_clinical_episodes_get",
        "parameters": [
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": "live",
              "enum": [
                "live",
                "sim"
              ],
              "title": "Stream",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clinical Episodes",
        "tags": [
          "clinical"
        ]
      }
    },
    "/clinical/test-result": {
      "post": {
        "description": "Append a ClinicalTestResult. The payload is the body, verbatim, and nothing more.",
        "operationId": "clinical_test_result_clinical_test_result_post",
        "parameters": [
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": "live",
              "enum": [
                "live",
                "sim"
              ],
              "title": "Stream",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestResultIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clinical Test Result",
        "tags": [
          "clinical"
        ]
      }
    },
    "/clinical/upstream-search": {
      "post": {
        "description": "Ask the environmental side to look upstream of an area it has no episode for.\n\nThe area is resolved back to its zone here, on the environmental side, so the\nrequest carries the node the kernel would search from. An area this catchment\ndoes not know is refused rather than logged as a request nobody can act on.",
        "operationId": "upstream_search_clinical_upstream_search_post",
        "parameters": [
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": "live",
              "enum": [
                "live",
                "sim"
              ],
              "title": "Stream",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpstreamSearchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upstream Search",
        "tags": [
          "clinical"
        ]
      }
    },
