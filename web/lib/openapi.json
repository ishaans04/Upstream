      "LabIn": {
        "description": "A lab result is not a field observation.\n\nIt carries no `result` (it is quantitative by definition) and no snap distance:\nthe sample is tied to a node id by the chain of custody, not by a GPS fix.",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/ObservationMethod"
          },
          "mission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Id"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "oah_codes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Oah Codes",
            "type": "array"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "observer_id": {
            "title": "Observer Id",
            "type": "string"
          },
          "observer_type": {
            "default": "lab",
            "title": "Observer Type",
            "type": "string"
          },
          "snap_distance_m": {
            "default": 0.0,
            "title": "Snap Distance M",
            "type": "number"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
