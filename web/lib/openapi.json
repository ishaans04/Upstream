            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "outfall_id",
          "node_id",
          "ts",
          "active"
        ],
        "title": "OverflowIn",
        "type": "object"
      },
      "ProposeIn": {
        "properties": {
          "free_text": {
            "default": "",
            "title": "Free Text",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "photo_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Uri"
          }
        },
        "required": [
          "lon",
          "lat",
          "observed_at"
        ],
        "title": "ProposeIn",
        "type": "object"
      },
      "RainfallIn": {
        "properties": {
          "antecedent_dry_h": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Antecedent Dry H"
          },
          "mm_per_h": {
            "title": "Mm Per H",
            "type": "number"
          },
          "stream": {
            "default": "live",
            "title": "Stream",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
