          "node_id",
          "observed_at",
          "method",
          "value",
          "unit",
          "observer_id"
        ],
        "title": "LabIn",
        "type": "object"
      },
      "ObservationMethod": {
        "enum": [
          "citizen_visual_olfactory",
          "citizen_freetext",
          "citizen_photo",
          "test_strip",
          "sensor_turbidity",
          "sensor_conductivity",
          "sensor_normal_window",
          "field_test",
          "lab_ecoli",
          "lab_enterococci",
          "overflow_telemetry",
          "bioassessment"
