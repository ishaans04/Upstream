# ---- Phase 0 ----
POSTGRES_USER=upstream
POSTGRES_PASSWORD=
POSTGRES_DB=upstream
# Per-role passwords; the postgres init scripts read these from the container env.
CLINICAL_DB_PASSWORD=
KERNEL_DB_PASSWORD=
HAPI_DB_PASSWORD=
DATABASE_URL=
KERNEL_DATABASE_URL=
CLINICAL_DATABASE_URL=
CATCHMENT_ID=
# ---- Phase 3 ----
ANTHROPIC_API_KEY=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# ---- Phase 6 ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# ---- Phase 7 ----
HAPI_BASE_URL=http://hapi:8080/fhir
OAH_IG_VERSION=
TX_SERVER_URL=
SNOMED_LICENCE_ACCEPTED=
# ---- Phase 8 ----
# Seconds between runs of the clinical daily job; 0 disables the timer. Default 86400.
CLINICAL_DAILY_INTERVAL_S=
# ---- Phase 10 ----
# Only for `npm run dev` against an API elsewhere; the web container ignores it and
# always reaches the Core API through its own /api/core (same origin, no CORS).
NEXT_PUBLIC_API_BASE_URL=
# Not used: the basemap is a self-hosted OpenStreetMap extract (web/public/basemap.json).
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Which stream the web app shows: live (default) or sim (the demo).
WEB_STREAM=
# Streams whose posteriors open episodes: live (default), or live,sim for the demo.
EPISODE_STREAMS=
# The catchment's IANA time zone; the mission daylight gate is local. Default Asia/Kolkata.
CATCHMENT_TZ=
# ---- Phase 11 ----
# Signs MVP access tokens (openssl rand -hex 32). Empty: every token is refused.
JWT_SIGNING_KEY=
# Keys observer pseudonyms in research exports (openssl rand -hex 32). Empty: no export.
EXPORT_PSEUDONYM_KEY=
# A public_health token for the clinical service, minted from JWT_SIGNING_KEY:
#   python -m upstream_api.security mint --sub clinical-stats --role public_health --days 365
CLINICAL_CORE_API_TOKEN=
# ---- Phase 12 ----
DEPLOY_HOST=
DEPLOY_SSH_KEY_PATH=
PUBLIC_BASE_URL=
