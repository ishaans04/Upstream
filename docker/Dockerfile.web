# The web app (Phase 10). Built with the Core API's in-network address baked into the
# same-origin rewrite, so the browser only ever talks to this container.
FROM node:22-alpine AS build
WORKDIR /web
ARG CORE_API_URL=http://api:8000
ARG NEXT_PUBLIC_STREAM=live
ARG NEXT_PUBLIC_API_BASE_URL=
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY=
ENV CORE_API_URL=$CORE_API_URL NEXT_PUBLIC_STREAM=$NEXT_PUBLIC_STREAM \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S web && adduser -S web -G web
COPY --from=build --chown=web:web /web/.next/standalone ./
COPY --from=build --chown=web:web /web/.next/static ./.next/static
COPY --from=build --chown=web:web /web/public ./public
USER web
EXPOSE 3000
CMD ["node", "server.js"]
